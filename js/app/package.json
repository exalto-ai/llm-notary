{
  "name": "llm-notary-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:platform-api": "node scripts/generate-platform-api.mjs",
    "check:platform-api": "node scripts/generate-platform-api.mjs --check",
    "build": "npm run check:frontend && npm run check:platform-api && npm run check:docs && npm run build:site",
    "build:site": "npm run check:platform-types && vite build",
    "check:frontend": "biome check .",
    "check:docs": "node scripts/check-docs.mjs",
    "format": "biome check --write .",
    "check:platform-types": "tsc -p tsconfig.platform.json",
    "test:site": "vitest run --config vitest.site.config.js",
    "test:install": "sh scripts/test-install.sh",
    "test:unit": "vitest run --environment node src/notaryLifecycle.test.ts src/creditUtilization.test.js",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.26.0",
    "openapi-fetch": "^0.15.2",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.0",
    "shadcn": "^4.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
