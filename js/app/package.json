{
  "name": "llm-notary-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:dashboard": "vite --mode local-dashboard --host 127.0.0.1",
    "generate:local-api": "node scripts/generate-local-api.mjs",
    "check:local-api": "node scripts/generate-local-api.mjs --check",
    "generate:platform-api": "node scripts/generate-platform-api.mjs",
    "check:platform-api": "node scripts/generate-platform-api.mjs --check",
    "build": "npm run check:local-api && npm run check:platform-api && npm run build:site && npm run build:dashboard",
    "build:site": "npm run check:platform-types && vite build",
    "check:platform-types": "tsc -p tsconfig.platform.json",
    "check:dashboard-types": "tsc -p tsconfig.dashboard.json",
    "build:dashboard": "npm run check:dashboard-types && vite build --mode local-dashboard",
    "capture:dashboard-docs": "node scripts/capture-dashboard-docs.mjs",
    "check:local-docs": "node scripts/check-local-docs.mjs",
    "test:dashboard": "vitest run --config vitest.dashboard.config.js",
    "test:site": "vitest run --config vitest.site.config.js",
    "test:unit": "vitest run --environment node src/notaryLifecycle.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "preview:dashboard": "vite preview --outDir ../../crates/llm-notary-client/dashboard --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.26.0",
    "openapi-fetch": "^0.15.2",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.62.0",
    "shadcn": "^4.16.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
