http:// {
	route {
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@brand path /notary-mark.svg /favicon.svg /social-preview.png /social-preview.svg
		header @brand Cache-Control "public, max-age=0, must-revalidate"

		@favicon path /favicon.ico
		header @favicon Cache-Control "public, max-age=0, must-revalidate"

		@legacy_docs path_regexp legacy_docs ^/docs/?(.*)$
		redir @legacy_docs /#/docs/{re.legacy_docs.1} 308

		handle {
			root * /usr/share/caddy
			encode zstd gzip
			try_files {path} /index.html
			file_server
		}
	}
}
