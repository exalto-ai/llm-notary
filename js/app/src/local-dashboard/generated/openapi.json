  "components": {
    "schemas": {
      "ArtifactResponse": {
        "type": "object",
        "required": [
          "kind",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "CaptureDetailResponse": {
        "type": "object",
        "required": [
          "capture",
          "artifacts",
          "finalizations"
        ],
        "properties": {
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArtifactResponse"
            }
          },
          "capture": {
            "$ref": "#/components/schemas/CaptureResponse"
          },
          "finalizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationResponse"
            }
          }
        }
      },
      "CaptureListResponse": {
        "type": "object",
        "required": [
          "items",
          "limit",
          "offset"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaptureResponse"
            }
          },
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "CaptureResponse": {
        "type": "object",
        "required": [
          "capture_id",
          "created_at_unix_ms",
          "provider",
          "operation",
          "streaming",
          "request_bytes",
          "capture_state",
          "finalization_state",
          "prompt_preview",
          "prompt_preview_truncated",
          "output_preview",
          "output_preview_truncated"
        ],
        "properties": {
          "capture_id": {
            "type": "string"
          },
          "capture_state": {
            "type": "string"
          },
          "completed_at_unix_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
