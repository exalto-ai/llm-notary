format = "llm-notary/agent-config/v1"

[cluster]
proxy_origin = "https://__PROXY_DOMAIN__"
admin_origin = "https://__ADMIN_DOMAIN__"

[proxy]
listen = "0.0.0.0:8787"

[admin]
listen = "0.0.0.0:8788"

[admin.auth]
username = "admin"

[storage]
backend = "s3"
bundle_dir = "/var/lib/llm-notary/data/bundles"
finalized_dir = "/var/lib/llm-notary/data/traces"

[storage.s3]
bucket = "llm-notary-private"
region = "us-east-1"
endpoint = "http://minio:9000"
prefix = "cluster"
force_path_style = true
allow_insecure_http = true
connect_timeout_seconds = 5
operation_timeout_seconds = 30

[catalog]
backend = "postgres"
path = "/var/lib/llm-notary/data/catalog.db"
prompt_preview_chars = 1000
output_preview_chars = 1000
full_text_search = true

[catalog.postgres]
ssl_mode = "disable"
max_connections = 8
connect_timeout_seconds = 5
acquire_timeout_seconds = 5
migration_lock_timeout_seconds = 30

[notary]
endpoint = "__NOTARY_ENDPOINT__"
public_key = "__NOTARY_PUBLIC_KEY__"
