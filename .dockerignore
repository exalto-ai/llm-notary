# The Rust images require workspace sources, pinned protocol dependencies, and
# the small assets embedded in the daemon CLI. Keeping the context narrow
# prevents unrelated web and doc changes from invalidating cached build layers.
*
!Cargo.toml
!Cargo.lock
!runtime/
!runtime/**
runtime/target/
runtime/apps/local-dashboard/node_modules/
runtime/apps/local-dashboard/.vitest-attachments/
!platform/
!platform/**
!deploy/
!deploy/notary-server-entrypoint.sh
!js/
!js/desktop/
!js/desktop/src-tauri/
!js/desktop/src-tauri/Cargo.toml
!js/desktop/src-tauri/src/
!js/desktop/src-tauri/src/lib.rs
