# The Rust images require workspace sources, pinned protocol dependencies, and
# the small assets embedded in the daemon CLI. Keeping the context narrow
# prevents unrelated web and doc changes from invalidating cached build layers.
*
!Cargo.toml
!Cargo.lock
!runtime/
!runtime/**
runtime/target/
runtime/apps/admin-dashboard/node_modules/
runtime/apps/admin-dashboard/.vitest-attachments/
!platform/
!platform/**
!deploy/
!deploy/notary-server-entrypoint.sh
!js/
!apps/notary-app/
!apps/notary-app/src-tauri/
!apps/notary-app/src-tauri/Cargo.toml
!apps/notary-app/src-tauri/src/
!apps/notary-app/src-tauri/src/lib.rs
