# The notary image only requires its Rust package and the vendored TLSNotary
# sources. Keeping the context narrow prevents unrelated web and doc changes
# from invalidating its cached build layer.
*
!Cargo.toml
!Cargo.lock
!build.rs
!src/
!src/**
!tests/
!tests/**
!migrations-postgres/
!migrations-postgres/**
!vendor/
!vendor/tlsn/
!vendor/tlsn/**
