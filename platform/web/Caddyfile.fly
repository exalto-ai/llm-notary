:80 {
	route {
		handle_path /downloads/* {
			reverse_proxy https://notary-prod-downloads.t3.tigrisfiles.io {
				header_up Host notary-prod-downloads.t3.tigrisfiles.io
			}
		}

		handle /api/* {
			# Flycast accepts HTTP on port 80 and forwards it to the API's
			# configured internal port (8080). Do not target that internal port
			# directly from another Fly app.
			reverse_proxy http://llm-notary-prod-api.flycast {
				header_up X-Notary-Client-IP {http.request.header.Fly-Client-IP}
				lb_try_duration 8s
				lb_try_interval 250ms
			}
		}

		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@brand path /notary-mark.svg /favicon.svg /social-preview.png
		header @brand Cache-Control "public, max-age=0, must-revalidate"

		@favicon path /favicon.ico
		header @favicon Cache-Control "public, max-age=0, must-revalidate"

		@installer path /install.sh
		header @installer Cache-Control "no-store"

		@shared path /s/*
		header @shared X-Robots-Tag "noindex, nofollow, noarchive"

		@legacy_docs path_regexp legacy_docs ^/docs/?(.*)$
		redir @legacy_docs /#/docs/{re.legacy_docs.1} 308

		handle {
			root * /usr/share/caddy
			encode zstd gzip
			try_files {path} /index.html
			file_server
		}
	}
}
