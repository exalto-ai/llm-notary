# Written automatically by the GitHub Actions deploy workflow on the Droplet.
# For a local Compose run, copy this file to deploy.env and fill the values.
NOTARY_IMAGE=ttl.sh/llm-notary-notary-example:24h
WEB_IMAGE=ttl.sh/llm-notary-web-example:24h
API_IMAGE=ttl.sh/llm-notary-api-example:24h
NOTARY_SIGNING_KEY_FILE=/opt/llm-notary/notary-signing-key
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-named-tunnel-token
LLM_NOTARY_PUBLIC_ORIGIN=https://example.com
LLM_NOTARY_NOTARY_HOST=203.0.113.10
# Compressed SEC1 public key corresponding to NOTARY_SIGNING_KEY_FILE.
LLM_NOTARY_NOTARY_PUBLIC_KEY=0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798
LLM_NOTARY_NOTARY_DIRECTORY_GENERATION=1
LLM_NOTARY_NOTARY_VALID_FROM_UNIX_MS=0
GITHUB_OAUTH_CLIENT_ID=replace-with-the-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-the-github-oauth-client-secret
LLM_NOTARY_S3_ACCESS_KEY_ID=replace-with-the-bucket-scoped-spaces-access-key
LLM_NOTARY_S3_SECRET_ACCESS_KEY=replace-with-the-bucket-scoped-spaces-secret-key
LLM_NOTARY_S3_BUCKET=llm-notary-intake-prod
LLM_NOTARY_S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
LLM_NOTARY_S3_REGION=sfo3
LLM_NOTARY_S3_PREFIX=llm-notary
LLM_NOTARY_INTAKE_MAX_BYTES=134217728
LLM_NOTARY_INTAKE_UPLOAD_TTL_SECS=900
# Optional: enables generated Library titles and controlled tags after admission.
OPENAI_API_KEY=replace-with-the-library-metadata-key
LLM_NOTARY_LIBRARY_METADATA_MODEL=gpt-5.6-luna
LLM_NOTARY_LIBRARY_METADATA_WEEKLY_BUDGET_CENTS=1000
# gpt-5.6-luna standard pricing in micro-USD per token: $1/M input, $6/M output.
LLM_NOTARY_LIBRARY_METADATA_INPUT_MICROUSD_PER_TOKEN=1
LLM_NOTARY_LIBRARY_METADATA_OUTPUT_MICROUSD_PER_TOKEN=6
WEB_HTTP_PORT=80
NOTARY_PORT=7047
