:80 {
	route {
		@shared path /s/*
		header @shared X-Robots-Tag "noindex, nofollow, noarchive"

		handle /api/* {
			reverse_proxy notary-api:8080 {
				header_up X-Notary-Client-IP {http.request.header.CF-Connecting-IP}
				lb_try_duration 8s
				lb_try_interval 250ms
			}
		}

		handle {
			reverse_proxy site:80 {
				lb_try_duration 8s
				lb_try_interval 250ms
			}
		}
	}
}
